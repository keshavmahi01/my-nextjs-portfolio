# Required in production (Vercel)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/keshav
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=any-long-random-string

# Optional: send contact form messages to email (Gmail app password works)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO=you@gmail.com

# Optional: Google API key for the Drive gallery (can also be pasted in the dashboard, My Work tab)
GOOGLE_API_KEY=
